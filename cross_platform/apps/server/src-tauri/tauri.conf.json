{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Exam Guard Server",
  "version": "0.1.11",
  "identifier": "com.examguard.server",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Exam Guard Server",
        "width": 960,
        "height": 700,
        "minWidth": 800,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png"],
    "targets": "all"
  }
}
