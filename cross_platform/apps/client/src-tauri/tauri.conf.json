{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Exam Guard Client",
  "version": "0.1.9",
  "identifier": "com.examguard.client",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Exam Guard Client",
        "width": 460,
        "height": 620,
        "minWidth": 460,
        "minHeight": 620
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png"],
    "targets": "all"
  }
}
